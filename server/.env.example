# Server
PORT=5000
NODE_ENV=development

# MongoDB — add your connection string
MONGODB_URI=mongodb://127.0.0.1:27017/chess_game

# JWT — add a long random secret
JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# Frontend origin (CORS + Socket.IO)
CLIENT_URL=http://localhost:5173

# Default time controls (seconds)
DEFAULT_TIME_CONTROL=600
DEFAULT_INCREMENT=0
